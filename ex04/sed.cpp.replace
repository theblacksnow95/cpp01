#include "sed.hpp"

int	sed(std::string& bigusDickus, std::string s1, std::string s2)
{
	std::ifstream	inFile;
	std::string		buff;
	std::ofstream	outFile(bigusDickus + ".replace");

	inFile.open(bigusDickus);
	if (inFile.fail() || outFile.fail())
		return (std::cout << "Error opening the file." << std::endl, 1);
	if (s1.empty() || s2.empty())
		return (1);
	while (getline(inFile, buff))
	{
		int	i = buff.find(s1);
		if (i < 0)
		{
			outFile << buff << std::endl;
			continue;
		}
		std::string firstChunk = buff.substr(0, i);
		std::string secondChunk = buff.substr(i + s1.size(), buff.size());
		firstChunk.append(s2).append(secondChunk);
		outFile << firstChunk << std::endl;
	}
	outFile.close();
	inFile.close();
	return(0);
}
