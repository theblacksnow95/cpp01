# include "sedsedkaubsedjkhbsed.hpp"

int	main(int ac, char **av)
{
	if (ac != 4)
		return (std::cout << "Error: incorrect args. " << "./sedsedkaubsedjkhbsed Filename, String1, String2" << std::endl, 1);
	else
	{
		std::string	fileName = av[1];
		std::string s1 = av[2];
		std::string s2 = av[3];
		sedsedkaubsedjkhbsed(fileName, s1, s2);
	}
}
